{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src"]
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Browser-safe package: DOM lib for TextEncoder/crypto, no Node types.
    "lib": ["ES2023", "DOM"],
    "types": []
  },
  "include": ["src", "test"]
}
