# Copy to .env.local (git-ignored) on each laptop and fill in. Every process reads only these variables.

# ---- Modes -------------------------------------------------------------------
WALLET_MODE=mock                 # mock | real
AI_MODE=mock                     # mock | real
AUTO_MINE=true                   # regtest only: agent mines a block after each payment
NODE_ENV=development

# ---- Hosts (use LAN IPs when running across laptops) ------------------------
AGENT_URL=http://localhost:4000
AI_URL=http://localhost:4300
CLIENT_PARTY_URL=http://localhost:4101
FREELANCER_PARTY_URL=http://localhost:4102

# ---- Agent (apps/agent) -----------------------------------------------------
AGENT_PORT=4000
AGENT_DATA_DIR=./apps/agent/data
VERIFY_DEFAULT_TIMEOUT_SEC=60
AI_PARSE_TIMEOUT_MS=90000
AI_EXPLAIN_TIMEOUT_MS=30000

# ---- AI (apps/ai, native Windows) ------------------------------------------
AI_PORT=4300
AI_HOST=0.0.0.0
AI_MODEL=QWEN3_5_4B_MULTIMODAL_Q4_K_M         # @qvac/sdk 0.21.0 constant (Qwen3.5 4B, Q4)
AI_FALLBACK_MODEL=QWEN3_5_2B_MULTIMODAL_Q4_K_M # Qwen3.5 2B, Q4; last resort: QWEN3_5_0_8B_MULTIMODAL_Q4_K_M
AI_DEVICE=gpu                    # gpu | cpu (CPU works, GPU is the organizers' "safe bet")
AI_REASONING_BUDGET=0            # 0 = thinking OFF (required for tool_choice / JSON on Qwen3.5), -1 = on
QVAC_CONFIG_PATH=./qvac.config.json

# ---- RGB / wallets (WSL2) ----------------------------------------------------
RGB_NETWORK=regtest
RGB_INDEXER_URL=tcp://localhost:50001
RGB_TRANSPORT_ENDPOINT=rpc://localhost:3000/json-rpc
RGB_DATA_DIR=./.wallets          # each role gets a subfolder: ./.wallets/<role>
ESCROW_ASSET_ID=                 # written by `npm run demo:setup`
ESCROW_ASSET_TICKER=TUSDT        # MUST be all uppercase: rgb-lib rejects mixed case with
                                 # InvalidTicker "ticker needs to be all uppercase" (verified on
                                 # regtest 2026-10-17). The asset NAME is free-form, so the UI can
                                 # still display "tUSDT".
ESCROW_ASSET_PRECISION=6
FEE_RATE=2
MIN_CONFIRMATIONS=1
MAX_FEE_SAT=5000
MIN_FREE_UTXOS=5
WALLET_POLL_MS=2000              # regtest; use >= 10000 on signet (shared public esplora)
MOCK_LEDGER_PATH=./.mock-ledger.json
MOCK_SETTLE_MS=3000
MOCK_FAIL_AMOUNT=                # optional, base units: a payment of exactly this amount FAILS
                                 # instead of settling (sender refunded). Drives the refund path
                                 # in mock mode without a code change. Empty = never fail.

# Optional Mutinynet profile (plain signet; WDK adapter does NOT support signetcustom):
# RGB_NETWORK=signet
# RGB_INDEXER_URL=https://esplora.signet.kaleidoswap.com   # fallback: https://mutinynet.com/api (rate-limited)
# RGB_TRANSPORT_ENDPOINT=rpcs://proxy.kaleidoswap.com/json-rpc
# AUTO_MINE=false
# WALLET_POLL_MS=10000

# Mnemonics: one per role, NEVER the same on two laptops, NEVER committed.
AGENT_MNEMONIC=
CLIENT_MNEMONIC=
FREELANCER_MNEMONIC=
TREASURY_MNEMONIC=

# ---- Party server (apps/party) ----------------------------------------------
ROLE=client                      # client | freelancer
PARTY_PORT=4101

# ---- bitcoind JSON-RPC (regtest stack, used by /dev/mine) -------------------
BITCOIND_RPC_URL=http://localhost:18443
BITCOIND_RPC_USER=
BITCOIND_RPC_PASS=

# ---- Web (apps/web, Vite) ---------------------------------------------------
VITE_AGENT_URL=http://localhost:4000
VITE_PARTY_URL=http://localhost:4101
