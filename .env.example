# Copy to .env.local (git-ignored) on each laptop and fill in. Every process reads only these variables.

# ---- Modes -------------------------------------------------------------------
WALLET_MODE=mock                 # mock | real
AI_MODE=mock                     # mock | real
AUTO_MINE=true                   # regtest only: agent mines a block after each payment
NODE_ENV=development

# ---- Hosts (use LAN IPs when running across laptops) ------------------------
AGENT_URL=http://localhost:4000
AI_URL=http://localhost:4300
CLIENT_PARTY_URL=http://localhost:4101
FREELANCER_PARTY_URL=http://localhost:4102

# ---- Agent (apps/agent) -----------------------------------------------------
AGENT_PORT=4000
AGENT_DATA_DIR=./apps/agent/data
VERIFY_DEFAULT_TIMEOUT_SEC=60
AI_PARSE_TIMEOUT_MS=90000
AI_EXPLAIN_TIMEOUT_MS=30000

# ---- AI (apps/ai, native Windows) ------------------------------------------
AI_PORT=4300
AI_HOST=0.0.0.0
AI_MODEL=                        # exact @qvac/sdk constant, e.g. the Qwen 4B Q4 constant
AI_FALLBACK_MODEL=               # e.g. the Qwen 2B Q4 constant
AI_DEVICE=gpu                    # gpu | cpu
QVAC_CONFIG_PATH=./qvac.config.json

# ---- RGB / wallets (WSL2) ----------------------------------------------------
RGB_NETWORK=regtest
RGB_INDEXER_URL=tcp://localhost:50001
RGB_TRANSPORT_ENDPOINT=rpc://localhost:3000/json-rpc
RGB_DATA_DIR=./.wallets          # each role gets a subfolder: ./.wallets/<role>
ESCROW_ASSET_ID=                 # written by `npm run demo:setup`
ESCROW_ASSET_TICKER=tUSDT
ESCROW_ASSET_PRECISION=6
FEE_RATE=2
MIN_CONFIRMATIONS=1
MAX_FEE_SAT=5000
MIN_FREE_UTXOS=5
MOCK_LEDGER_PATH=./.mock-ledger.json
MOCK_SETTLE_MS=3000

# Mnemonics: one per role, NEVER the same on two laptops, NEVER committed.
AGENT_MNEMONIC=
CLIENT_MNEMONIC=
FREELANCER_MNEMONIC=
TREASURY_MNEMONIC=

# ---- Party server (apps/party) ----------------------------------------------
ROLE=client                      # client | freelancer
PARTY_PORT=4101

# ---- bitcoind JSON-RPC (regtest stack, used by /dev/mine) -------------------
BITCOIND_RPC_URL=http://localhost:18443
BITCOIND_RPC_USER=
BITCOIND_RPC_PASS=

# ---- Web (apps/web, Vite) ---------------------------------------------------
VITE_AGENT_URL=http://localhost:4000
VITE_PARTY_URL=http://localhost:4101
